{
  "name": "chunkline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:source && npm run check:corpus && npm run check:claims",
    "check:source": "node tools/check-source.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "verify": "node tools/verify.mjs",
    "check:corpus": "node tools/check-corpus.mjs",
    "build:corpus": "node tools/build-corpus.mjs",
    "check:claims": "node tools/check-claims.mjs",
    "check:page": "node tools/check-page.mjs"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": true
  }
}
